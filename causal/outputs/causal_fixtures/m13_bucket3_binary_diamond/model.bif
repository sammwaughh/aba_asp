network m13_bucket3_binary_diamond {
}
variable x0 {
    type discrete [ 2 ] { 0, 1 };
}
variable x1 {
    type discrete [ 2 ] { 0, 1 };
}
variable x2 {
    type discrete [ 2 ] { 0, 1 };
}
variable x3 {
    type discrete [ 2 ] { 0, 1 };
}
probability ( x0 ) {
    table 0.5, 0.5 ;
}
probability ( x1 | x0 ) {
    ( 0 ) 0.7, 0.3;
    ( 1 ) 0.3, 0.7;

}
probability ( x2 | x0 ) {
    ( 0 ) 0.7, 0.3;
    ( 1 ) 0.3, 0.7;

}
probability ( x3 | x1, x2 ) {
    ( 0, 0 ) 0.8, 0.2;
    ( 0, 1 ) 0.35, 0.65;
    ( 1, 0 ) 0.35, 0.65;
    ( 1, 1 ) 0.2, 0.8;

}
